---
// The BeeD Energy logo (chosen 2026-10-27): "BeeD" on a green label, "Energy" beside it. The letters are
// Plus Jakarta Sans (Tokotype, SIL Open Font License) outlined to paths, so the logo never waits for a font.
// The label takes --logo-label and the letters on it --logo-on-label (global.css sets both per ground);
// "Energy" follows currentColor. Pass label when nothing around the logo already names it.
interface Props { height?: number; label?: string; class?: string }
const { height = 28, label, class: cls } = Astro.props;
const width = Math.round((height * 6535) / 1197);
---
