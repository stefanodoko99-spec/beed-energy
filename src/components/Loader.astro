---
// Brand loader: a battery charges cell by cell in the logo's green while the % counts to 100, flashes full,
// then the curtain lifts (Belgrade Arbor's % curtain, made electric). Home page only, once per session,
// skippable, hard time-out in site.ts. Whether it plays is decided in <head> before the first paint
// (LOADER_SCRIPT in src/lib/csp.ts); `hidden` keeps it away without scripts.
import { type Lang } from '../lib/i18n';
import { tc } from '../i18n/common';
import Logo from './Logo.astro';
interface Props { lang: Lang; }
const t = tc(Astro.props.lang);
---
<div class="loader" data-loader hidden aria-hidden="true">
  <button class="btn btn--ghost loader__skip" type="button" data-loader-skip>{t.loader.skip}</button>
  <div class="loader__stage">
    <div class="loader__batt">
      <div class="loader__cells" data-loader-cells>{Array.from({ length: 10 }, () => <i></i>)}</div>
      <svg class="loader__bolt" data-loader-bolt viewBox="0 0 32 48" aria-hidden="true" focusable="false"><path d="M20 2 4 27h10l-3 19 17-27H17z" /></svg>
    </div>
    <p class="loader__pct"><span data-loader-pct>0</span><b>%</b></p>
  </div>
  <div class="loader__meta"><span>{t.loader.loading}</span><Logo height={18} /></div>
</div>
