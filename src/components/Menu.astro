---
// Full-screen menu: every category with its live product count and lowest price (Decor Systems' counts, see DESIGN.md),
// in two groups: renewable energy, then efficiency and building (docs/renewable-focus-plan.md §2).
import Logo from './Logo.astro';
import type { Category } from '../lib/catalog';
import { href, type Lang } from '../lib/i18n';
import { lek } from '../lib/money';
import { categoryHref, categoryName, groupCategories } from '../lib/energy-nav';
import { tc } from '../i18n/common';
import { tr } from '../i18n/renewables';
interface Props { lang: Lang; cats: Category[]; }
const { lang, cats } = Astro.props;
const t = tc(lang);
const r = tr(lang).nav;
const groups = groupCategories(cats);
const heading = { energy: t.groups.energy, 'efficiency-build': r.efficiencyBuild } as const;
let n = 0;
---
<div class="menu on-ink" id="site-menu" hidden data-menu role="dialog" aria-modal="true" aria-label={t.nav.menu}>
  <div class="menu__top">
    <a class="brand" href={href(lang, 'home')} aria-label={lang === 'sq' ? 'BeeD Energy, kreu' : 'BeeD Energy, home'}><Logo /></a>
    <button class="btn btn--ghost btn--s" type="button" data-menu-close>{t.nav.close} <span aria-hidden="true">✕</span></button>
  </div>
  <div class="menu__grid">
    <div class="menu__cats">
      {groups.map((g) => (
        <section class="menu__group" aria-labelledby={`menu-g-${g.key}`}>
          <h2 class="eyebrow menu__group-h" id={`menu-g-${g.key}`}>{heading[g.key]} <span class="menu__group-n">· {g.cats.length}</span></h2>
          <div class="menu__group-list">
            {g.cats.map((c) => {
              n++;
              return (
                <a class="menu__cat" href={categoryHref(lang, c)}>
                  <span class="n">{String(n).padStart(2, '0')}</span>
                  <span class="name">{categoryName(lang, c)}</span>
                  <span class="meta">{t.menu.products(c.product_count ?? 0)}<br />{c.min_price ? `${t.menu.from} ${lek(c.min_price, lang)}` : t.menu.empty}</span>
                </a>
              );
            })}
          </div>
        </section>
      ))}
    </div>
    <div class="menu__side">
      <nav class="menu__big" aria-label={t.nav.menu}>
        <a href={href(lang, 'shop')}>{t.nav.shop}</a>
        <a href={href(lang, 'packages')}>{r.packages}</a>
        <a href={href(lang, 'guide')}>{r.guide}</a>
        <a href={href(lang, 'calculator')}>{r.calculator}</a>
        <a href={href(lang, 'quote')}>{t.nav.quote}</a>
        <a href={href(lang, 'sellers')}>{t.nav.sellers}</a>
        <a href={href(lang, 'sell')}>{t.nav.sell}</a>
      </nav>
      <form class="stack-s" action={href(lang, 'search')} method="get" role="search">
        <label class="eyebrow" for="menu-q">{t.nav.search}</label>
        <div class="row" style="flex-wrap:nowrap">
          <input class="input" id="menu-q" name="q" type="search" autocomplete="off" placeholder={lang === 'sq' ? 'p.sh. inverter hibrid, lesh guri…' : 'e.g. hybrid inverter, stone wool…'} style="background:transparent;color:inherit;border-color:var(--line-on-teal-ui)" />
          <button class="btn btn--copper" type="submit">{t.nav.search}</button>
        </div>
      </form>
      <ul class="stack-s" style="list-style:none;padding:0">
        <li><a class="link-arrow" href={href(lang, 'about')}><span>{t.nav.about}</span><span class="arrow" aria-hidden="true">→</span></a></li>
        <li><a class="link-arrow" href={href(lang, 'contact')}><span>{t.nav.contact}</span><span class="arrow" aria-hidden="true">→</span></a></li>
      </ul>
      <button class="saver" type="button" aria-pressed="false" data-saver><span class="saver__track" aria-hidden="true"></span><span>{t.saver.label}</span></button>
    </div>
  </div>
</div>
