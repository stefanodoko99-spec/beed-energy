---
// Product page: the "Fleta teknike" (drawing + title block), the offers table sorted by total delivered,
// specifications, price history, price alert, related products and the phone action bar.
import { productReviews } from '../lib/reviews';
import { tx } from '../i18n/extras';
import Site from '../layouts/Site.astro';
import ProductPhoto from '../components/ProductPhoto.astro';
import ProductCard from '../components/ProductCard.astro';
import OffersTable from '../components/OffersTable.astro';
import PriceHistory from '../components/PriceHistory.astro';
import SpecSheet from '../components/SpecSheet.astro';
import TitleBlock from '../components/TitleBlock.astro';
import CompatPairBlock from '../components/CompatPairBlock.astro';
import { worksWith } from '../lib/compat-products';
import { COMPAT_METHOD } from '../content/battery-compat';
import { tc } from '../i18n/compat';
import { attributes, categoryById, offersFor, priceHistory, productCardsByIds, productImages, productSpecs, related } from '../lib/catalog';
import { readCompare } from '../lib/basket';
import { date, href, type Lang } from '../lib/i18n';
import { cities as allCities, drawingNo, fitDesc, fitTitle, offerRows, parseSources, price, priceLong, unitPrice } from '../lib/shop-data';
import { num } from '../lib/money';
import { chosenCitySlug } from '../lib/city-pref';
import { ts } from '../i18n/shop';
import '../styles/shop.css';
import '../styles/compat.css';

import type { AlertFlash } from '../lib/shop-alerts';
interface Props { lang: Lang; product: any; flash: AlertFlash; }
const { lang, product: p, flash } = Astro.props;
const t = ts(lang);
const P = t.product;
const other: Lang = lang === 'sq' ? 'en' : 'sq';
const cat = (await categoryById(p.category_id))!;
const card = (await productCardsByIds([p.id]))[0];
const specs = await productSpecs(p.id, p.category_id);
const attrs = await attributes(p.category_id);
const photos = await productImages(p.id);
const altOf = (ph: { alt_sq: string; alt_en: string }) => (lang === 'sq' ? ph.alt_sq : ph.alt_en) || name;
const name: string = lang === 'sq' ? p.name_sq : p.name_en;
const catName = lang === 'sq' ? cat.name_sq : cat.name_en;
const summary: string = (lang === 'sq' ? p.summary_sq : p.summary_en) || '';
const body: string = (lang === 'sq' ? p.body_sq : p.body_en) || '';
const unitLabel = lang === 'sq' ? cat.unit_label_sq : cat.unit_label_en;
const basis = cat.unit_basis ? card?.specs[cat.unit_basis] : null;

// City: ?qyteti= (sq) or ?city= (en); either works in both languages.
const CITY = { sq: 'qyteti', en: 'city' } as const;
const cityList = await allCities();
// …or, without one, the city remembered from an earlier product, basket or calculator page (city-pref.ts).
const citySlug = await chosenCitySlug(Astro.url, Astro.cookies);
const city = cityList.find((c) => c.slug === citySlug) ?? null;
const cityName = city ? (lang === 'sq' ? city.name_sq : city.name_en) : null;

const rows = await offerRows(await offersFor(p.id), city, typeof basis === 'number' ? basis : null);
const live = rows.filter((r) => r.stock_qty > 0 && r.total !== null);
const bestOffer = live.find((r) => r.best) ?? live[0] ?? null;
const prices = rows.map((r) => r.price_all);
const lowPrice = prices.length ? Math.min(...prices) : null;
const highPrice = prices.length ? Math.max(...prices) : null;
const sellerCount = new Set(rows.map((r) => r.seller_id)).size;
const anyDemo = rows.some((r) => r.isDemo);
const history = await priceHistory(p.id, 90);
const rel = await related(p, 4);
// Verified reviews (lib/reviews.ts): only from delivered orders, shown once approved.
const reviews = await productReviews(p.id);
const rv = tx(lang).reviews;
const compared = new Set(readCompare(Astro.cookies));
const sources = parseSources(p.sources_json);
const dno = drawingNo(cat.id, p.id);
const dims = [p.width_mm, p.height_mm, p.depth_mm];
const path = href(lang, 'product', { slug: p.slug });
const altPath = href(other, 'product', { slug: p.slug }) + (city ? `?${CITY[other]}=${city.slug}` : '');

const title = fitTitle([P.metaTitle(p.brand, p.model), P.metaTitleShort(p.brand, p.model), name]);
const description = fitDesc(P.metaDesc(name, rows.length, lowPrice !== null ? priceLong(lowPrice, lang) : null));

const origin = Astro.url.origin;
const jsonld: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name,
    description: summary || undefined,
    brand: { '@type': 'Brand', name: p.brand },
    model: p.model,
    mpn: p.model,
    sku: dno,
    category: catName,
    url: origin + path,
    ...(photos.length ? { image: photos.map((ph) => origin + ph.path) } : {}),
    ...(p.weight_kg ? { weight: { '@type': 'QuantitativeValue', value: p.weight_kg, unitCode: 'KGM' } } : {}),
    // only real, approved reviews from delivered orders
    ...(reviews.count && reviews.avg ? { aggregateRating: { '@type': 'AggregateRating', ratingValue: Math.round(reviews.avg * 10) / 10, reviewCount: reviews.count, bestRating: 5, worstRating: 1 } } : {}),
    ...(rows.length && lowPrice !== null
      ? {
          offers: {
            '@type': 'AggregateOffer',
            priceCurrency: 'ALL',
            lowPrice,
            highPrice,
            offerCount: rows.length,
            availability: live.length ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
          },
        }
      : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.home, item: origin + href(lang, 'home') },
      { '@type': 'ListItem', position: 2, name: t.shop, item: origin + href(lang, 'shop') },
      { '@type': 'ListItem', position: 3, name: catName, item: origin + href(lang, 'category', { slug: lang === 'sq' ? cat.slug_sq : cat.slug_en }) },
      { '@type': 'ListItem', position: 4, name, item: origin + path },
    ],
  },
];

// Price alert form state from the flash cookie (set by /api/price-alert, read once).
const errs = new Set(flash?.errors ?? []);
const alertOk = !!flash?.ok;
const firstErr = errs.has('email') ? 'alert-email' : errs.has('target') ? 'alert-target' : null;
const quoteHref = href(lang, 'quote', {}, { produkt: p.slug });

// "Punon me / Works with": the batteries (or inverters) the makers list for this product, from src/content/battery-compat.ts.
// null for inverters with no battery input and every other product: no section at all.
const works = await worksWith(p.slug);
const cw = tc(lang);
const key = (n: number) => String(n + (works && n >= 3 ? 1 : 0)).padStart(2, '0');
---
<Site lang={lang} title={title} description={description} alternate={altPath} current="category" categorySlug={cat.slug_en} jsonld={jsonld} bodyClass="has-actionbar">
  <article class="product" data-product data-slug={p.slug}>
    <header class="wrap product__crumbs">
      <nav aria-label={lang === 'sq' ? 'Gjurma' : 'Breadcrumb'} class="crumbs">
        <ol>
          <li><a href={href(lang, 'home')}>{t.home}</a></li>
          <li><a href={href(lang, 'shop')}>{t.shop}</a></li>
          <li><a href={href(lang, 'category', { slug: lang === 'sq' ? cat.slug_sq : cat.slug_en })}>{catName}</a></li>
          <li aria-current="page">{p.brand} {p.model}</li>
        </ol>
      </nav>
    </header>

    <section class="wrap sheet" aria-labelledby="product-title">
      <figure class="sheet__drawing gallery" data-fan-source>
        <div class="sheet__paper gallery__main">
          <ProductPhoto src={photos[0]?.path} alt={photos[0] ? altOf(photos[0]) : name} brand={p.brand} model={p.model} width={photos[0]?.width} height={photos[0]?.height} eager />
        </div>
        {photos.length > 1 && (
          <ul class="gallery__thumbs" role="list" aria-label={lang === 'sq' ? 'Fotot e produktit' : 'Product photos'}>
            {photos.map((ph, i) => (
              <li>
                <a class="gallery__thumb" href={ph.path} data-gallery-thumb data-alt={altOf(ph)} data-w={ph.width ?? ''} data-h={ph.height ?? ''} aria-current={i === 0 ? 'true' : undefined}>
                  <img src={ph.path} alt={`${lang === 'sq' ? 'Foto' : 'Photo'} ${i + 1}`} loading="lazy" decoding="async" />
                </a>
              </li>
            ))}
          </ul>
        )}
      </figure>

      <div class="sheet__info">
        <h1 id="product-title" class="title product__title">{name}</h1>
        {summary && <p class="lede product__summary">{summary}</p>}

        <div class="buybox" aria-labelledby="buybox-label">
          {lowPrice !== null ? (
            <>
              <p id="buybox-label" class="eyebrow">{bestOffer ? P.bestOffer : P.lowest}</p>
              <p class="price price--big buybox__price">{price(bestOffer?.price_all ?? lowPrice, lang)}</p>
              <p class="buybox__meta small">
                <span>{t.vatIncl}</span>
                <span>{t.offersFromSellers(rows.length, sellerCount)}</span>
                {bestOffer && card?.unit_price && unitLabel && typeof basis === 'number' && <span class="mono">{unitPrice(bestOffer.price_all / basis, unitLabel, lang)}</span>}
              </p>
              {lowPrice !== highPrice && highPrice !== null && <p class="small muted mono">{P.priceRange(priceLong(lowPrice, lang), priceLong(highPrice, lang))}</p>}
              <p class="small buybox__delivery">
                {bestOffer && city && bestOffer.fee !== null
                  ? <>{P.deliveryFromBest(bestOffer.fee === 0 ? P.free : priceLong(bestOffer.fee, lang), cityName!)} · {P.bestTotal(priceLong(bestOffer.total!, lang))}</>
                  : P.deliveryExtra}
              </p>
              <div class="buybox__actions">
                {bestOffer ? (
                  <form method="post" action="/api/cart" data-cart-form>
                    <input type="hidden" name="offerId" value={bestOffer.id} />
                    <input type="hidden" name="qty" value={bestOffer.qty} />
                    <button class="btn" type="submit">{P.addBest} <span class="visually-hidden">({bestOffer.seller_name})</span></button>
                  </form>
                ) : (
                  <a class="btn" href={quoteHref}>{t.requestQuote}</a>
                )}
                <a class="link-arrow" href="#ofertat"><span>{P.seeOffers}</span><span class="arrow" aria-hidden="true">↓</span></a>
              </div>
            </>
          ) : (
            <>
              <p id="buybox-label" class="eyebrow">{t.noOffers}</p>
              <p class="small">{P.noOffersText}</p>
              <div class="buybox__actions"><a class="btn" href={quoteHref}>{t.requestQuote} <span class="arrow" aria-hidden="true">→</span></a></div>
            </>
          )}
          <form class="buybox__compare" method="post" action="/api/compare" data-compare-form>
            <input type="hidden" name="productId" value={p.id} />
            <button class="cmp-toggle" type="submit" aria-pressed={compared.has(p.id) ? 'true' : 'false'} data-compare-toggle={p.id} aria-label={t.compare.label(name)}>
              <span class="cmp-toggle__box" aria-hidden="true"></span>
              <span class="cmp-toggle__off" aria-hidden="true">{t.compare.add}</span><span class="cmp-toggle__on" aria-hidden="true">{t.compare.on}</span>
            </button>
          </form>
        </div>

        <TitleBlock class="product__tb" items={[
          { label: P.brand, value: p.brand, noTranslate: true },
          { label: P.model, value: p.model, noTranslate: true },
          { label: P.drawingNo, value: dno },
          { label: P.dims, value: dims.some(Boolean) ? dims.map((v) => (v ? num(v, 0, lang) : '—')).join(' × ') : null },
          { label: P.weight, value: p.weight_kg ? `${num(p.weight_kg, p.weight_kg < 10 ? 1 : 0, lang)} kg` : null },
          { label: P.warranty, value: p.warranty_years ? P.years(num(p.warranty_years, 0, lang)) : null },
          { label: P.scale, value: P.noScale },
          { label: P.source, value: sources[0]?.label, href: sources[0]?.url, external: true },
        ]} />
        {p.datasheet_url && (
          <a class="link-arrow product__datasheet" href={p.datasheet_url} rel="noopener external" target="_blank">
            <span>{P.datasheet}</span><span class="arrow" aria-hidden="true">↗</span>
          </a>
        )}
      </div>
    </section>

    <section id="ofertat" class="wrap product__section" aria-labelledby="offers-title" tabindex="-1">
      <div class="section-head">
        <p class="key section-head__key" aria-hidden="true">01</p>
        <h2 id="offers-title" class="title section-head__title">{P.offersTitle}</h2>
        {rows.length > 0 && <p class="mono small muted">{t.offersFromSellers(rows.length, sellerCount)}</p>}
      </div>
      {rows.length ? (
        <>
          <OffersTable lang={lang} rows={rows} cities={cityList} city={city} cityParam={CITY[lang]} action={path} unitLabel={unitLabel} productName={name} slug={p.slug} />
          {anyDemo && <p class="small muted product__demo">{t.sampleNote}</p>}
        </>
      ) : (
        <div class="empty">
          <p class="title">{P.noOffersTitle}</p>
          <p class="muted">{P.noOffersText}</p>
          <a class="btn" href={quoteHref}>{t.requestQuote} <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      )}
    </section>

    <section class="wrap product__section" aria-labelledby="specs-title">
      <div class="section-head">
        <p class="key section-head__key" aria-hidden="true">02</p>
        <h2 id="specs-title" class="title section-head__title">{P.specs}</h2>
      </div>
      <div class="product__specs">
        <SpecSheet lang={lang} specs={specs} w={p.width_mm} h={p.height_mm} d={p.depth_mm} weight={p.weight_kg} warranty={p.warranty_years} />
        {(body || sources.length > 0) && (
          <div class="product__about">
            {body && <><h3 class="eyebrow">{P.summary}</h3><div class="prose"><p>{body}</p></div></>}
            {sources.length > 0 && (
              <>
                <h3 class="eyebrow">{P.sources}</h3>
                <ul class="product__sources" role="list">
                  {sources.map((s) => <li><a href={s.url} rel="noopener external" target="_blank">{s.label}</a></li>)}
                </ul>
              </>
            )}
          </div>
        )}
      </div>
    </section>

    {works && (
      <section class="wrap product__section" aria-labelledby="works-title">
        <div class="section-head">
          <p class="key section-head__key" aria-hidden="true">03</p>
          <h2 id="works-title" class="title section-head__title">{cw.worksH}</h2>
        </div>
        {works.entries.length > 0 && <p class="small muted ww__lede">{cw.worksLede[works.role]}</p>}
        {works.notes.map((n) => (
          <div class="cp-note">
            <p class="cp-note__tag">{cw.noteTag}</p>
            <p class="small">{n.text[lang]}</p>
            {n.sources.length > 0 && (
              <ul class="cp__src" role="list" aria-label={cw.sourcesLabel}>
                {n.sources.map((s) => (
                  <li><a class="cp-ext" href={s.url} target="_blank" rel="noopener noreferrer"><span class="cp-ext__t">{s.title}</span><span class="visually-hidden">{cw.newTab}</span><span class="cp-ext__arrow" aria-hidden="true">↗</span></a></li>
                ))}
              </ul>
            )}
          </div>
        ))}
        {works.entries.length > 0 ? (
          <ul class="ww" role="list">
            {works.entries.map(({ pair, product }) => (
              <li class="ww__item">
                <h3 class="ww__name"><a href={href(lang, 'product', { slug: product.slug })} translate="no">{product.brand} {product.model}</a></h3>
                <CompatPairBlock lang={lang} pair={pair} idPrefix={`ww-${product.slug}`} docDates />
              </li>
            ))}
          </ul>
        ) : (
          works.notes.length === 0 && <p class="ww__none">{cw.worksNone[works.role]}</p>
        )}
        <p class="small muted ww__method">{COMPAT_METHOD[lang]}</p>
      </section>
    )}

    <section class="wrap product__section product__duo" aria-label={`${P.history} · ${P.alert}`}>
      <div>
        <div class="section-head">
          <p class="key section-head__key" aria-hidden="true">{key(3)}</p>
          <h2 class="title section-head__title">{P.history}</h2>
        </div>
        <p class="small muted">{P.historyIntro}</p>
        <PriceHistory lang={lang} points={history} />
      </div>
      <div id="njoftim" tabindex="-1">
        <div class="section-head">
          <p class="key section-head__key" aria-hidden="true">{key(4)}</p>
          <h2 class="title section-head__title">{P.alert}</h2>
        </div>
        <p class="small muted">{P.alertIntro}</p>
        {alertOk ? (
          <p class="notice notice--ok" role="status" data-autofocus>{P.alertOk(flash?.target ? priceLong(Number(flash.target), lang) : '')}</p>
        ) : (
          <form class="alert-form" method="post" action="/api/price-alert" novalidate data-first-error={firstErr ?? undefined}>
            {errs.size > 0 && <p class="form-errors" role="alert">{errs.has('rate') ? P.errRate : P.alertErrors}</p>}
            <input type="hidden" name="productId" value={p.id} />
            <input type="hidden" name="lang" value={lang} />
            <div class="hp" aria-hidden="true"><label for="alert-website">Website</label><input id="alert-website" name="website" tabindex="-1" autocomplete="off" /></div>
            <div class="field">
              <label for="alert-email">{P.email}</label>
              <input class="input" id="alert-email" name="email" type="email" autocomplete="email" spellcheck="false" required value={flash?.email ?? ''}
                aria-invalid={errs.has('email') ? 'true' : undefined} aria-describedby={errs.has('email') ? 'alert-email-err' : undefined} />
              {errs.has('email') && <p class="error" id="alert-email-err">{P.errEmail}</p>}
            </div>
            <div class="field">
              <label for="alert-target">{P.target}</label>
              <input class="input mono" id="alert-target" name="target" inputmode="numeric" autocomplete="off" required value={flash?.target ?? ''}
                aria-invalid={errs.has('target') ? 'true' : undefined} aria-describedby={`alert-target-hint${errs.has('target') ? ' alert-target-err' : ''}`} />
              <p class="hint" id="alert-target-hint">{lowPrice !== null ? P.targetHint(priceLong(lowPrice, lang)) : P.historyEmpty}</p>
              {errs.has('target') && <p class="error" id="alert-target-err">{P.errTarget}</p>}
            </div>
            <button class="btn" type="submit">{P.alertSubmit}</button>
            <p class="small muted">{P.alertPrivacy}</p>
          </form>
        )}
      </div>
    </section>

    <section class="wrap product__section" id="vleresimet" aria-labelledby="reviews-title">
      <div class="section-head">
        <h2 id="reviews-title" class="title section-head__title">{rv.h2}</h2>
        {reviews.count > 0 && reviews.avg && <p class="mono small muted"><span class="rv-avg" aria-hidden="true">{'★'.repeat(Math.round(reviews.avg))}{'☆'.repeat(5 - Math.round(reviews.avg))}</span> {num(reviews.avg, 1, lang)} · {rv.avg(reviews.count)}</p>}
      </div>
      {reviews.count === 0 ? <p class="muted">{rv.none}</p> : (
        <ul class="rv-list">
          {reviews.list.map((r) => (
            <li class="rv">
              <p class="rv__head"><span class="rv__stars" role="img" aria-label={rv.stars(r.rating)}>{'★'.repeat(r.rating)}{'☆'.repeat(5 - r.rating)}</span> <b>{r.name}</b> <span class="tag tag--ok"><span aria-hidden="true">✓</span> {rv.verified}</span> <time class="mono small muted" datetime={r.created_at.replace(' ', 'T') + 'Z'}>{date(r.created_at, lang)}</time></p>
              {r.body && <p class="rv__body">{r.body}</p>}
            </li>
          ))}
        </ul>
      )}
    </section>

    {rel.length > 0 && (
      <section class="wrap product__section" aria-labelledby="related-title">
        <div class="section-head">
          <p class="key section-head__key" aria-hidden="true">{key(5)}</p>
          <h2 id="related-title" class="title section-head__title">{P.related}</h2>
        </div>
        <ul class="results results--wide" role="list">
          {rel.map((r) => <li><ProductCard p={r} lang={lang} category={cat.slug_en} unitLabel={unitLabel} attrs={attrs} compared={compared.has(r.id)} /></li>)}
        </ul>
      </section>
    )}

    <div class="actionbar" data-actionbar>
      <div class="actionbar__price">
        {lowPrice !== null ? <><span class="small muted">{P.barFrom}</span> <span class="price">{price(bestOffer?.price_all ?? lowPrice, lang)}</span></> : <span class="small">{t.noOffers}</span>}
      </div>
      <a class="btn btn--ghost btn--s actionbar__btn" href={quoteHref} aria-label={t.requestQuote}><span class="actionbar__t">{P.barQuote}</span></a>
      {bestOffer && (
        <form class="actionbar__form" method="post" action="/api/cart" data-cart-form>
          <input type="hidden" name="offerId" value={bestOffer.id} />
          <input type="hidden" name="qty" value={bestOffer.qty} />
          <button class="btn btn--s actionbar__btn" type="submit" aria-label={P.addBest}><span class="actionbar__t">{P.barAdd}</span></button>
        </form>
      )}
    </div>
  </article>
</Site>

<script>
  import '../scripts/product';
</script>
