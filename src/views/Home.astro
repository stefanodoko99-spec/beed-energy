---
// Home: the glowing-house hero, then "Shtëpia ndizet" — the same house at dusk with its equipment, pinned full
// screen while the chapters scroll over it; the camera flies to each chapter's equipment and cuts to its close-up
// (DESIGN.md signature, scripts/home.ts), then the manifesto, how it works, featured products, Albania in
// numbers, the calculator and the seller band.
import Site from '../layouts/Site.astro';
import '../styles/home.css';
import { LAYERS, NUMBERS, type Fact, type Part } from '../content/story';
import { FRAME, HOUSE_WIDTHS, SHOTS, SHOT_WIDTHS, sceneSrcset, shotOf } from '../lib/stage-scenes';
import { ts } from '../i18n/stage';
import { categories, featuredProducts } from '../lib/catalog';
import ProductPhoto from '../components/ProductPhoto.astro';
import VoltMark from '../components/VoltMark.astro';
import HomeTeasers from '../components/HomeTeasers.astro';
import { energyLines } from '../lib/energy-line';
import { keepAcronyms } from '../lib/nobreak';
import { all, get } from '../lib/db';
import { href, type Lang } from '../lib/i18n';
import { lek, num } from '../lib/money';
import { th } from '../i18n/home';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = th(lang);
const s = ts(lang);
const other = lang === 'sq' ? 'en' : 'sq';

const cats = await categories();
const bySlug = new Map(cats.map((c) => [c.slug_en, c]));
const counts = (await get<{ products: number; offers: number }>(
  `SELECT (SELECT COUNT(*) FROM products WHERE status = 'published') AS products,
          (SELECT COUNT(*) FROM offers o JOIN sellers s ON s.id = o.seller_id WHERE o.active = 1 AND s.status = 'active') AS offers`,
))!;

// Facts computed from datasheets in the catalogue (the best value per category, with its product).
const best = async (cat: string, key: string, dir: 'MIN' | 'MAX') =>
  await get<{ v: number; slug: string; brand: string; model: string }>(
    `SELECT ps.value_num AS v, p.slug, p.brand, p.model FROM product_specs ps
       JOIN spec_attributes a ON a.id = ps.attribute_id JOIN products p ON p.id = ps.product_id JOIN categories c ON c.id = p.category_id
      WHERE c.slug_en = ? AND a.key = ? AND ps.value_num > 0 AND p.status = 'published' ORDER BY ps.value_num ${dir === 'MIN' ? 'ASC' : 'DESC'} LIMIT 1`,
    cat,
    key,
  );
const lambda = await best('insulation', 'thermal_conductivity_w_mk', 'MIN');
const uw = (await best('windows', 'uw_w_m2k', 'MIN')) ?? (await best('windows', 'uf_w_m2k', 'MIN'));
const cop = await best('heat-pumps', 'cop_a7w35', 'MAX');

type Link = { label: string; url: string };
type Shown = { value: string; text: string; source?: Link; also?: Link; product?: { slug: string; name: string } };
// Source labels are bilingual in story.ts; print the one for this page's language.
const srcFor = (src: Fact['source']): Link => ({ label: src.label[lang], url: src.url });
type AnyFact = Fact | 'insulation' | 'windows' | 'heat';
function factFor(f: AnyFact): Shown {
  if (f === 'insulation') {
    if (!lambda) return t.insulationNone;
    const r = t.insulation(num(lambda.v, 3, lang), num(0.1 / lambda.v, 2, lang));
    return { ...r, product: { slug: lambda.slug, name: `${lambda.brand} ${lambda.model}` } };
  }
  if (f === 'windows') {
    if (!uw) return t.windowsNone;
    return { ...t.windows(num(uw.v, 2, lang)), product: { slug: uw.slug, name: `${uw.brand} ${uw.model}` } };
  }
  if (f === 'heat') {
    if (!cop) return t.heatNone;
    return { ...t.heat(num(cop.v, 2, lang)), product: { slug: cop.slug, name: `${cop.brand} ${cop.model}` } };
  }
  const x = f as Fact;
  return { value: x.value[lang], text: x.text[lang], source: srcFor(x.source), also: x.also && srcFor(x.also) };
}

// Every fact of a chapter, headline first (story.ts `facts`; older content had `fact` + `extra`).
type LayerLike = { fact?: AnyFact; extra?: Fact; facts?: readonly AnyFact[] };
const factsOf = (l: LayerLike): AnyFact[] => [...(l.facts ?? [l.fact, l.extra])].filter((f): f is AnyFact => !!f);

// The stage: each chapter's close-up and its spot on the wide shot (lib/stage-scenes.ts), and the chapter count
// for the "01 / 07" keys.
const pad = (n: number) => String(n).padStart(2, '0');
const total = pad(LAYERS.length);
const finaleN = Math.max(0, ...LAYERS.map((l) => l.n)) + 1;
const shotFor = new Map(LAYERS.map((l) => [l.n, shotOf(l.parts)]));
// The tag names the shelf of what the camera looks at; a chapter with two parts (heat pump + solar water heater)
// names both shelves, with their products counted together and the lowest price of the two.
const PART_SHELF: Partial<Record<Part, string>> = { pv: 'solar-panels', inverter: 'inverters', battery: 'batteries', heatpump: 'heat-pumps', swh: 'solar-water-heaters', ev: 'ev-chargers' };
type Cat = (typeof cats)[number];
const hudShelves = (l: (typeof LAYERS)[number]): Cat[] => {
  const own = l.parts.map((p) => PART_SHELF[p]).filter((s): s is string => !!s && l.categories.includes(s));
  const list = (own.length > 1 ? own : l.categories.slice(0, 1)).map((s) => bySlug.get(s)).filter((c): c is Cat => !!c);
  return list;
};
// The tag's product per shelf: the most-offered published product, one with a photo first.
const faceRows = await all<{ category_id: number; slug: string; brand: string; model: string; image: string | null; min_price: number }>(
  `SELECT p.category_id, p.slug, p.brand, p.model, MIN(o.price_all) AS min_price, COUNT(o.id) AS n,
          (SELECT path FROM product_images i WHERE i.product_id = p.id ORDER BY sort LIMIT 1) AS image
     FROM products p JOIN offers o ON o.product_id = p.id AND o.active = 1 AND o.seller_id IN (SELECT id FROM sellers WHERE status = 'active')
    WHERE p.status = 'published' GROUP BY p.id ORDER BY (image IS NULL), n DESC, p.id`,
);
const faces = new Map<number, (typeof faceRows)[number]>();
for (const r of faceRows) if (!faces.has(r.category_id)) faces.set(r.category_id, r);
const cities = await all<{ slug: string; name_sq: string; name_en: string; pv_yield: number }>('SELECT slug, name_sq, name_en, pv_yield FROM cities WHERE pv_yield IS NOT NULL ORDER BY pv_yield DESC');
const tirana = cities.find((c) => c.slug === 'tirane') ?? cities[0];
const featured = await featuredProducts(8);
const catOf = new Map(cats.map((c) => [c.id, c]));
const energy = await energyLines(featured, (id) => catOf.get(id)?.slug_en, { url: Astro.url, cookies: Astro.cookies, locals: Astro.locals }, lang);
const manifestoWords = t.manifesto.split(' ');
// The hero: a solar panel for the glass card (the most-offered one), the battery shelf and Tirana's yield.
const panelPick = featured.find((p) => catOf.get(p.category_id)?.slug_en === 'solar-panels') ?? featured[0];
const panelsCat = bySlug.get('solar-panels');
const batteriesCat = bySlug.get('batteries');
const catHref = (c: Cat) => href(lang, 'category', { slug: lang === 'sq' ? c.slug_sq : c.slug_en });
const yieldTxt = tirana ? num(tirana.pv_yield, 0, lang) : '';
const scene = (name: string) => [960, 1440, 2048].map((w) => `/scenes/${name}-${w}.webp ${w}w`).join(', ');

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'BeeD Energy',
    inLanguage: lang,
    potentialAction: { '@type': 'SearchAction', target: `${Astro.url.origin}${href(lang, 'search')}?q={q}`, 'query-input': 'required name=q' },
  },
];
---
<Site lang={lang} title={t.title} description={t.description} alternate={href(other, 'home')} current="home" chrome="#33423e" loader jsonld={jsonld}>
  {/* The hero (after the glowing-house reference): the house at dusk under three words and two volt marks, two
      leader tags on the house, a glass card and three cards along the bottom. Images: public/scenes/ (ASSETS.md). */}
  <section class="vhero" data-vhero aria-labelledby="vhero-title">
    <div class="vhero__scene" aria-hidden="true">
      <div class="vhero__frame" data-vhero-frame>
        <img class="vhero__img" src="/scenes/hero-house-1440.webp" srcset={scene('hero-house')} sizes="max(100vw, 178svh)" width="2048" height="1152" alt="" fetchpriority="high" decoding="async" />
        {/* leader lines in the photo's own coordinates (1600 × 900 = the frame), from a point on the house to its tag */}
        <svg class="vhero__leads" viewBox="0 0 1600 900">
          <line x1="720" y1="360" x2="880" y2="306" pathLength="1" />
          <line x1="1008" y1="531" x2="928" y2="432" pathLength="1" />
          <circle class="vhero__ping" cx="720" cy="360" r="7" /><circle class="vhero__dot" cx="720" cy="360" r="5" />
          <circle class="vhero__ping" cx="1008" cy="531" r="7" style="animation-delay:1.2s" /><circle class="vhero__dot" cx="1008" cy="531" r="5" />
        </svg>
        <span class="vtag" style="--x:55%;--y:34%">{t.hero.tagPanels}</span>
        {yieldTxt && <span class="vtag" style="--x:58%;--y:48%">{t.hero.tagYield(yieldTxt)}</span>}
      </div>
      <div class="vhero__shade"></div>
    </div>

    <div class="vhero__top">
      <p class="eyebrow vhero__eyebrow" data-vhero-in>{t.eyebrow}</p>
      <h1 class="vhero__title" id="vhero-title">
        {t.hero.words.map((w, i) => (
          <>
            {i > 0 && <span class="vhero__volt-wrap" style={`--d:${(i * 0.18 + 0.32).toFixed(2)}s`}><VoltMark class="vhero__volt" /></span>}
            <span class="vhero__word"><span data-vhero-word style={`--d:${(i * 0.18).toFixed(2)}s`}>{w}</span></span>
          </>
        ))}
      </h1>
    </div>

    <div class="vhero__mid">
      {panelPick && (
        <a class="vhero__card" href={panelsCat ? catHref(panelsCat) : href(lang, 'shop')} data-vhero-in>
          <span class="vhero__card-fig"><ProductPhoto src={panelPick.image} brand={panelPick.brand} model={panelPick.model} /></span>
          <span class="vhero__card-body">
            <span class="vhero__code mono">{panelPick.model.split(' (')[0]}</span>
            <span class="vhero__card-text">{t.hero.cardText}</span>
            <span class="vhero__card-cta">{t.hero.cardCta}</span>
          </span>
        </a>
      )}
      <div class="vhero__side" data-vhero-in>
        <p class="vhero__claim">{t.hero.side} <span class="vhero__sun"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.2" fill="currentColor" /><g stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 2.5v2.6M12 18.9v2.6M2.5 12h2.6M18.9 12h2.6M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8" /></g></svg>{t.hero.sun}</span></p>
        <div class="row vhero__cta">
          <a class="btn" href={href(lang, 'calculator')}>{t.calcCta} <span class="arrow" aria-hidden="true">→</span></a>
          <a class="btn btn--ghost" href={href(lang, 'shop')}>{t.shop}</a>
        </div>
      </div>
    </div>

    <ul class="vhero__cards">
      <li class="vcard vcard--a" style="--d:0.75s">
        <a href={href(lang, 'packages')}>
          <span class="vcard__title">{t.hero.packages}</span>
          <span class="vcard__text">{t.hero.packagesText}</span>
          <span class="vcard__cta">{t.hero.packagesCta}</span>
          <img class="vcard__img" src="/scenes/dusk-house-960.webp" width="960" height="540" alt="" loading="lazy" decoding="async" />
        </a>
      </li>
      <li class="vcard vcard--b" style="--d:0.87s">
        <a href={batteriesCat ? catHref(batteriesCat) : href(lang, 'shop')}>
          <span class="vcard__title">{t.hero.battery}</span>
          {batteriesCat && <span class="vcard__meta mono">{t.products(batteriesCat.product_count ?? 0)}{batteriesCat.min_price ? ` · ${t.from} ${lek(batteriesCat.min_price, lang)}` : ''}</span>}
          <img class="vcard__img" src="/scenes/battery-grass-1024.webp" srcset="/scenes/battery-grass-640.webp 640w, /scenes/battery-grass-1024.webp 1024w, /scenes/battery-grass-1536.webp 1536w" sizes="(max-width: 900px) 90vw, 33vw" width="1024" height="1024" alt="" loading="lazy" decoding="async" />
        </a>
      </li>
      <li class="vcard vcard--c" style="--d:0.99s">
        <a href={href(lang, 'calculator')}>
          <span class="vcard__title">{t.hero.calc}</span>
          {tirana && <span class="vcard__big figure">{yieldTxt}</span>}
          {tirana && <span class="vcard__text">{t.hero.calcText(yieldTxt, lang === 'sq' ? tirana.name_sq : tirana.name_en)}</span>}
          <span class="vcard__cta">{t.hero.calcCta}</span>
        </a>
      </li>
    </ul>
  </section>

  <section class="stage" data-stage aria-labelledby="stage-title">
    <div class="stage__intro" data-intro>
      <div class="stage__head">
        <p class="eyebrow">{t.hero.stageEyebrow}</p>
        <h2 class="title title--xl stage__title" id="stage-title">{t.hero.stageTitle}</h2>
      </div>
      <div class="stage__aside">
        <p class="lede">{t.lede}</p>
        <a class="link-arrow stage__quote" href={href(lang, 'quote')}><span>{t.quote}</span><span class="arrow" aria-hidden="true">→</span></a>
        <p class="mono small stage__stats">{t.stats(cats.length, counts.products, counts.offers)}</p>
      </div>
    </div>

    {/* The film: the wide shot pinned full screen while the chapters scroll over it. With motion on, home.ts is the
        camera (fly to the chapter's spot, cut to its close-up, pull back); without it this is a still of the house
        with its numbered spots, and each chapter shows its own close-up. Images: public/scenes/ (ASSETS.md). */}
    <div class="cine on-ink" data-cine data-finale={finaleN}>
      <figure class="cine__view" data-view>
        <div class="cine__cam" data-cam>
          <div class="cine__frame" data-frame>
            <img class="cine__house" src="/scenes/stage-house-1440.webp" srcset={sceneSrcset('stage-house', HOUSE_WIDTHS)} sizes="max(100vw, 178svh)" width="2048" height="1152" alt={t.drawingAlt} fetchpriority="low" decoding="async" />
            <div class="cine__glow" data-glow aria-hidden="true"></div>
            <ol class="cine__spots" aria-hidden="true">
              {LAYERS.map((l) => {
                const id = shotFor.get(l.n);
                if (!id) return null;
                const [x, y] = SHOTS[id].spot;
                return <li class="cine__spot" data-spot={l.n} style={`--x:${((x / FRAME.w) * 100).toFixed(2)}%;--y:${((y / FRAME.h) * 100).toFixed(2)}%`}><span>{pad(l.n)}</span></li>;
              })}
            </ol>
          </div>
        </div>
        <div class="cine__shots" aria-hidden="true">
          {LAYERS.map((l) => {
            const id = shotFor.get(l.n);
            if (!id) return null;
            const [fx, fy] = SHOTS[id].focus;
            return <img class="cine__shot" data-shot={l.n} src={`/scenes/stage-${id}-1024.webp`} srcset={sceneSrcset(`stage-${id}`, SHOT_WIDTHS)} sizes="100vw" width="2048" height="1152" style={`object-position:${fx * 100}% ${fy * 100}%`} alt="" loading="lazy" decoding="async" />;
          })}
        </div>
        <div class="cine__mist" data-mist aria-hidden="true"><i></i><i></i></div>
        <div class="cine__dust" data-dust aria-hidden="true"></div>
        <div class="cine__shade" aria-hidden="true"></div>
        <div class="cine__tags" aria-hidden="true">
          {LAYERS.map((l) => {
            const shelves = hudShelves(l);
            const first = shelves[0];
            if (!first) return null;
            const lows = shelves.map((c) => c.min_price).filter((v): v is number => !!v);
            const count = shelves.reduce((n, c) => n + (c.product_count ?? 0), 0);
            const face = faces.get(first.id);
            return (
              <a class="cine__tag" data-tag={l.n} tabindex="-1" href={face ? href(lang, 'product', { slug: face.slug }) : catHref(first)}>
                <span class="cine__tag-head"><span class="cine__tag-n mono">{pad(l.n)} / {total}</span><span class="cine__tag-cat">{shelves.map((c) => (lang === 'sq' ? c.name_sq : c.name_en)).join(' + ')}</span></span>
                {face && (
                  <span class="cine__tag-pick">
                    <span class="cine__tag-fig"><ProductPhoto src={face.image} brand={face.brand} model={face.model} /></span>
                    <span class="cine__tag-name"><b>{face.brand}</b> {face.model.split(' (')[0]}</span>
                  </span>
                )}
                <span class="cine__tag-meta mono">{t.products(count)} · {lows.length ? <>{t.from} {lek(Math.min(...lows), lang)}</> : t.noOffers} <span class="arrow">→</span></span>
              </a>
            );
          })}
        </div>
        <figcaption class="cine__caption mono">
          <span>{t.drawingTitle}</span>
          <span data-caption-layer aria-live="polite"></span>
          <span class="cine__stamp">{s.stamp}</span>
        </figcaption>
        <nav class="stage__keys" aria-label={t.layers}>
          {LAYERS.map((l) => <a href={`#shtresa-${l.n}`} class="stage__key" data-key-link={l.n} title={l.name[lang]}><span>{pad(l.n)}</span></a>)}
        </nav>
      </figure>

      <ol class="chapters" aria-label={t.layers}>
        {LAYERS.map((l) => {
          const [fact, ...more] = factsOf(l).map(factFor);
          const catMeta = (c: Cat) => `${t.products(c.product_count ?? 0)} · ${c.min_price ? `${t.from} ${lek(c.min_price, lang)}` : t.noOffers}`; // no-break space: "nga" stays with the price on phones
          const id = shotFor.get(l.n);
          const shot = id ? SHOTS[id] : null;
          return (
            <li
              class="chapter"
              id={`shtresa-${l.n}`}
              data-chapter={l.n}
              data-spot={shot ? `${shot.spot[0]} ${shot.spot[1]}` : undefined}
              data-zoom={shot?.zoom}
              data-focus={shot ? `${shot.focus[0]} ${shot.focus[1]}` : undefined}
            >
              <div class="chapter__card">
                {id && <img class="chapter__shot" src={`/scenes/stage-${id}-1024.webp`} srcset={sceneSrcset(`stage-${id}`, SHOT_WIDTHS)} sizes="(max-width: 900px) 100vw, 40vw" width="2048" height="1152" alt="" loading="lazy" decoding="async" />}
                <p class="chapter__key mono"><span class="tag tag--copper">{pad(l.n)} / {total}</span> <span class="chapter__short">{l.short[lang]}</span></p>
                <h2 class="title chapter__title">{l.name[lang]}</h2>
                {fact && <p class="chapter__fact"><strong class="chapter__value figure">{fact.value}</strong> {fact.text}</p>}
                <ul class="chapter__cats" aria-label={t.inShop}>
                  {l.categories.map((s) => {
                    const c = bySlug.get(s);
                    if (!c) return null;
                    return (
                      <li>
                        <a href={href(lang, 'category', { slug: lang === 'sq' ? c.slug_sq : c.slug_en })}>
                          <span class="chapter__cat">{lang === 'sq' ? c.name_sq : c.name_en}</span>
                          <span class="mono small chapter__meta">{catMeta(c)}</span>
                          <span class="arrow" aria-hidden="true">→</span>
                        </a>
                      </li>
                    );
                  })}
                </ul>
                {(fact?.source || fact?.product || more.length > 0) && (
                  <details class="chapter__more">
                    <summary class="mono">{t.more}</summary>
                    {fact?.source && <p class="small muted mono chapter__src">{t.source}: <a href={fact.source.url} rel="noopener" target="_blank">{fact.source.label}</a>{fact.also && <>; <a href={fact.also.url} rel="noopener" target="_blank">{fact.also.label}</a></>}</p>}
                    {fact?.product && <p class="small muted mono chapter__src">{t.datasheet}: <a href={href(lang, 'product', { slug: fact.product.slug })}>{fact.product.name}</a></p>}
                    {more.map((x) => (
                      <p class="chapter__extra">
                        <span class="chapter__extra-value figure">{x.value}</span>{/^[:;,.]/.test(x.text) ? '' : ' '}{x.text}
                        {x.source && <> <a class="small mono muted" href={x.source.url} rel="noopener" target="_blank">↗ {x.source.label}</a></>}
                        {x.also && <> <a class="small mono muted" href={x.also.url} rel="noopener" target="_blank">↗ {x.also.label}</a></>}
                        {x.product && <> <a class="small mono muted" href={href(lang, 'product', { slug: x.product.slug })}>{t.datasheet}: {x.product.name}</a></>}
                      </p>
                    ))}
                  </details>
                )}
              </div>
            </li>
          );
        })}
        <li class="chapter chapter--final" id="ndize" data-chapter={finaleN}>
          <div class="chapter__card">
            <p class="chapter__key mono"><span class="tag tag--sun">{t.final.key}</span></p>
            <h2 class="title title--xl chapter__title">{t.final.title}</h2>
            <p>{t.final.text}</p>
            {tirana && (
              <div class="final" data-final data-cities={JSON.stringify(cities.map((c) => ({ s: c.slug, y: Math.round(c.pv_yield * 5) })))}>
                <label class="eyebrow" for="final-city">{t.final.city}</label>
                <select class="select final__select" id="final-city" data-final-city>
                  {cities.map((c) => <option value={c.slug} selected={c.slug === tirana.slug}>{lang === 'sq' ? c.name_sq : c.name_en}</option>)}
                </select>
                <p class="final__out"><span class="final__num figure" data-final-num>{num(Math.round(tirana.pv_yield * 5), 0, lang).replace(/ /g, ' ')}</span> <span class="mono">{t.final.perYear}</span></p>
                <p class="small muted mono">{t.final.note}</p>
              </div>
            )}
            <a class="btn" href={href(lang, 'calculator')}>{t.final.calc} <span class="arrow" aria-hidden="true">→</span></a>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <HomeTeasers lang={lang} />

  <section class="manifesto on-ink section" aria-label={lang === 'sq' ? 'Manifesti' : 'Manifesto'}>
    <div class="wrap">
      <p class="manifesto__text" data-manifesto>
        {manifestoWords.map((w) => <span class="w">{w} </span>)}
      </p>
    </div>
  </section>

  <section class="how section" aria-labelledby="how-title">
    <div class="wrap">
      <p class="eyebrow">{t.how.eyebrow}</p>
      <h2 class="title title--xl" id="how-title">{t.how.title}</h2>
      <div class="how__grid">
        <div>
          <h3 class="eyebrow how__who">{t.how.buyers}</h3>
          <ol class="how__steps">
            {t.how.b.map(([h, p], i) => <li data-reveal><span class="mono how__n">0{i + 1}</span><h4>{h}</h4><p>{p}</p></li>)}
          </ol>
        </div>
        <div>
          <h3 class="eyebrow how__who">{t.how.sellers}</h3>
          <ol class="how__steps">
            {t.how.s.map(([h, p], i) => <li data-reveal><span class="mono how__n">0{i + 1}</span><h4>{h}</h4><p>{p}</p></li>)}
          </ol>
          <a class="link-arrow" href={href(lang, 'sell')}><span>{t.how.sell}</span><span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  {featured.length > 0 && (
    <section class="wrap section featured" aria-labelledby="featured-title">
      <div class="row between featured__head">
        <div>
          <p class="eyebrow">{t.featured.eyebrow}</p>
          <h2 class="title" id="featured-title">{t.featured.title}</h2>
        </div>
        <a class="link-arrow" href={href(lang, 'shop')}><span>{t.featured.all}</span><span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <ul class="featured__grid">
        {featured.map((p) => {
          const c = catOf.get(p.category_id);
          const e = energy.get(p.id);
          return (
            <li class="pcard" data-reveal>
              <div class="pcard__fig"><ProductPhoto src={p.image} brand={p.brand} model={p.model} /></div>
              <div class="pcard__body">
                <p class="pcard__brand">{p.brand} · {c ? (lang === 'sq' ? c.name_sq : c.name_en) : ''}</p>
                <h3 class="pcard__name"><a href={href(lang, 'product', { slug: p.slug })}>{lang === 'sq' ? p.name_sq : p.name_en}</a></h3>
                {e && <p class="pcard__energy" title={e.title}><span>{e.text}</span><span class="visually-hidden"> ({e.title})</span></p>}
                <div class="pcard__foot">
                  <span class="price">{p.min_price ? `${t.from} ${lek(p.min_price, lang)}` : t.noOffers}</span>
                  <span class="mono small muted">{p.offer_count} {lang === 'sq' ? (p.offer_count === 1 ? 'ofertë' : 'oferta') : p.offer_count === 1 ? 'offer' : 'offers'}</span>
                </div>
              </div>
            </li>
          );
        })}
      </ul>
    </section>
  )}

  <section class="numbers on-ink section" aria-labelledby="numbers-title">
    <div class="wrap numbers__wrap">
      <div class="numbers__head">
        <p class="eyebrow">{t.numbers.eyebrow}</p>
        <h2 class="title title--xl" id="numbers-title">{t.numbers.title}</h2>
      </div>
      <ol class="numbers__list">
        {NUMBERS.map((n) => (
          <li class="numbers__item" data-dim>
            <div class="dim">
              <span class="dim__tick" aria-hidden="true"></span>
              <span class="dim__rule" aria-hidden="true" data-dim-rule></span>
              <span class="dim__tick dim__tick--end" aria-hidden="true" data-dim-end></span>
              <span class="numbers__value figure" data-dim-value>{n.value[lang]}</span>
            </div>
            <p class="numbers__text" data-dim-text>{n.text[lang]}</p>
            <p class="numbers__src mono small" data-dim-text>
              <a href={n.source.url} rel="noopener" target="_blank">↗ {n.source.label[lang]}</a>
              {n.also && <a href={n.also.url} rel="noopener" target="_blank">↗ {n.also.label[lang]}</a>}
            </p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="calc-teaser wrap section" aria-labelledby="calc-title">
    <div class="calc-teaser__copy">
      <p class="eyebrow">{t.calc.eyebrow}</p>
      <h2 class="title title--xl" id="calc-title">{t.calc.title}</h2>
      <p class="lede">{keepAcronyms(t.calc.text)}</p>
      <a class="btn" href={href(lang, 'calculator')}>{t.calc.open} <span class="arrow" aria-hidden="true">→</span></a>
    </div>
    <table class="table calc-teaser__table">
      <caption class="visually-hidden">{t.calc.per}</caption>
      <thead><tr><th scope="col">{t.final.city}</th><th scope="col" class="num">{t.calc.per}</th><th scope="col" aria-hidden="true"></th></tr></thead>
      <tbody>
        {cities.map((c) => (
          <tr>
            <th scope="row"><a href={href(lang, 'calculator', {}, { qyteti: c.slug })}>{lang === 'sq' ? c.name_sq : c.name_en}</a></th>
            <td class="num mono">{num(c.pv_yield, 0, lang)}</td>
            <td class="calc-teaser__bar" aria-hidden="true"><i style={`--w:${((c.pv_yield - 1300) / 250).toFixed(3)}`}></i></td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="sell-band on-ink" aria-labelledby="sell-title">
    <div class="wrap sell-band__inner">
      <h2 class="poster sell-band__title" id="sell-title">{t.sellBand.title}</h2>
      <div class="stack-m sell-band__copy">
        <p class="lede" style="color:inherit">{t.sellBand.text}</p>
        <a class="btn btn--copper" href={href(lang, 'sell')}>{t.sellBand.cta} <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <script>
    import '../scripts/home';
  </script>
</Site>
