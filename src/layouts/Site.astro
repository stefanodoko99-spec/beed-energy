---
// Public layout: head (meta, hreflang, fonts, motion state before first paint), header, menu, dock, compare tray, footer.
import '../styles/base.css';
// base.css (starter reset + generic tokens) first, then tokens.css so the brand :root (DESIGN.md) wins.
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Menu from '../components/Menu.astro';
import Dock from '../components/Dock.astro';
import Footer from '../components/Footer.astro';
import Tray from '../components/Tray.astro';
import Loader from '../components/Loader.astro';
import { cartCount, readCart, readCompare } from '../lib/basket';
import { categories } from '../lib/catalog';
import { LOCALE, type Lang, type RouteKey } from '../lib/i18n';
import { tc } from '../i18n/common';
import { jsonForScript } from '../lib/html';
import { MOTION_SCRIPT, LOADER_SCRIPT } from '../lib/csp';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  alternate: string; // same page in the other language
  current?: RouteKey;
  tone?: 'paper' | 'ink'; // header colour over the first screen
  noindex?: boolean;
  jsonld?: Record<string, unknown>[];
  loader?: boolean;
  hideTray?: boolean;
  bodyClass?: string;
  nativeScroll?: boolean; // form pages (basket, checkout): the browser's own scroll, no smooth-scroll inertia
  categorySlug?: string; // categories.slug_en of the shelf this page belongs to (category and product pages): the header marks its link
}
const { lang, title, description, alternate, current, tone = 'paper', noindex = false, jsonld = [], loader = false, hideTray = false, bodyClass, nativeScroll = false, categorySlug } = Astro.props;
// One read of the categories for the whole shell: header links, menu and footer.
const cats = await categories();
const t = tc(lang);
const site = Astro.site?.origin ?? Astro.url.origin;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = site + path + (Astro.url.searchParams.has('p') && current === 'compare' ? `?p=${Astro.url.searchParams.get('p')}` : '');
const altUrl = site + alternate.split('?')[0];
const sqUrl = lang === 'sq' ? site + path : altUrl;
const enUrl = lang === 'en' ? site + path : altUrl;
const cart = readCart(Astro.cookies);
const cmp = readCompare(Astro.cookies);
const fullTitle = title.includes('BeeD') ? title : `${title} · BeeD Energy`;
const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'BeeD Energy',
  legalName: 'BeeD Consulting sh.p.k.',
  taxID: 'M41722050A',
  address: { '@type': 'PostalAddress', addressLocality: 'Tiranë', addressCountry: 'AL' },
  url: site,
};
---
<!doctype html>
<html lang={lang} data-motion="on" id="top" data-native-scroll={nativeScroll ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="sq" href={sqUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={sqUrl} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#f3f8f5" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="BeeD Energy" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={LOCALE[lang].replace('-', '_')} />
    <meta property="og:image" content={`${site}/og.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/archivo-latin.v1.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist-mono-latin.v1.woff2" as="font" type="font/woff2" crossorigin />
    <style is:inline>@view-transition { navigation: auto; }</style>
    <script is:inline set:html={MOTION_SCRIPT} />
    {loader && <script is:inline set:html={LOADER_SCRIPT} />}
    <script type="application/ld+json" set:html={jsonForScript(org)} />
    {jsonld.map((j) => <script type="application/ld+json" set:html={jsonForScript(j)} />)}
    <slot name="head" />
  </head>
  <body class={bodyClass} data-lang={lang} data-no-tray={hideTray ? '' : undefined}>
    {loader && <Loader lang={lang} />}
    <a class="skip-link" href="#main">{t.skip}</a>
    <Header lang={lang} alternate={alternate} current={current} categorySlug={categorySlug} cats={cats} cartCount={cartCount(cart)} compareCount={cmp.length} tone={tone} />
    <Menu lang={lang} cats={cats} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} cats={cats} />
    <Tray lang={lang} ids={cmp} hide={hideTray} />
    <Dock lang={lang} current={current} cartCount={cartCount(cart)} compareCount={cmp.length} />
    <div class="toasts" aria-live="polite" data-toasts data-msg={JSON.stringify({ added: t.toast.added, view: t.toast.view, error: t.toast.error, compared: t.toast.compared, full: t.tray.full, reset: t.tray.reset, saverOn: t.saver.on, saverOff: t.saver.off, cartHref: lang === 'sq' ? '/shporta' : '/en/cart', compareHref: lang === 'sq' ? '/krahaso' : '/en/compare', srCart1: t.cartCount(1), srCartN: t.cartCount(9999).replace('9999', '{n}'), srCompare1: t.compareCount(1), srCompareN: t.compareCount(9999).replace('9999', '{n}') })}></div>
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
